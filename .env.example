# EVolve AI - backend configuration
#
# Every value is optional. The application runs fully with none of these set.
# Copy to `.env` if you prefer, or export the variables in PowerShell.

# --- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Database --------------------------------------------------------------
# SQLite for hackathon reliability. To move to PostgreSQL, change only this:
#   DATABASE_URL=postgresql://user:password@localhost:5432/evolve
# No dialect-specific SQL exists in the codebase.
DATABASE_URL=sqlite:///./evolve.db

# --- Demo dataset ----------------------------------------------------------
# Batteries shown in the dashboard.
DEMO_FLEET_COUNT=75
# Batteries used to TRAIN and EVALUATE the models. Deliberately larger than the
# dashboard fleet so precision/recall rest on enough positive cases to mean
# something. Training on 75 rows would produce fragile metrics.
EVALUATION_COHORT_SIZE=1200
RANDOM_SEED=20261003

# --- Optional GenAI --------------------------------------------------------
# Leave GENAI_API_KEY empty and the app uses a deterministic local explainer.
# Nothing else changes: the response shape is identical either way.
GENAI_API_KEY=
GENAI_MODEL=gemini-2.0-flash
# GENAI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GENAI_TIMEOUT_SECONDS=6.0